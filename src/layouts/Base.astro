---
import '../styles/global.css';
import Mark from '../components/Mark.astro';
import { isPreview } from '../lib/site';
interface Props { title?: string; description?: string; noindex?: boolean; article?: boolean; date?: string }
const { title = '꼬똥을 위한 모든 선택', description = '앙두와 함께 모으는 꼬똥의 일상, 생활 가이드, 함께 가는 장소. 꼬똥픽 COTON PICK.', noindex = false, article = false, date } = Astro.props;
const pageTitle = `${title} | 꼬똥픽 COTON PICK`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const schema = { '@context': 'https://schema.org', '@type': article ? 'Article' : 'WebSite', name: pageTitle, headline: article ? title : undefined, description, url: canonical.href, inLanguage: 'ko-KR', datePublished: date, ...(article ? { author: { '@type': 'Organization', name: '꼬똥픽' } } : { sameAs: ['https://www.instagram.com/andu.coton/'] }) };
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
  <meta name="theme-color" content="#123f3b"/><title>{pageTitle}</title><meta name="description" content={description}/>
  <link rel="canonical" href={canonical}/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
  {(noindex || isPreview) && <meta name="robots" content="noindex,follow"/>}
  <meta property="og:locale" content="ko_KR"/><meta property="og:site_name" content="꼬똥픽 COTON PICK"/>
  <meta property="og:title" content={pageTitle}/><meta property="og:description" content={description}/><meta property="og:type" content={article ? 'article' : 'website'}/><meta property="og:url" content={canonical}/>
  <meta property="og:image" content={new URL('/og.png', Astro.site)}/><meta property="og:image:type" content="image/png"/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta property="og:image:alt" content="COTON PICK, 꼬똥을 위한 모든 선택"/>
  <meta name="twitter:card" content="summary"/>
  <script type="application/ld+json" set:html={JSON.stringify(schema).replaceAll('<', '\u003c')}/>
</head>
<body>
  <a href="#main" class="skip-link">본문으로 바로가기</a>
  <div class="topline">{isPreview ? '미리보기 · 일부 콘텐츠는 작성 예시입니다' : '앙두와 함께 고르는, 작고 소중한 일상'} <span aria-hidden="true">✳</span></div>
  <header class="site-header">
    <div class="header-inner wrap">
      <a href="/" class="brand" aria-label="꼬똥픽 홈"><Mark size={47}/><span>COTON PICK<small>꼬똥픽</small></span></a>
      <nav class="desktop-nav" aria-label="주 메뉴">
        <a href="/stories/" aria-current={path.startsWith('/stories/') ? 'page' : undefined}>앙두 스토리</a>
        <a href="/guides/" aria-current={path.startsWith('/guides/') ? 'page' : undefined}>꼬똥 가이드</a>
        <a href="/places/" aria-current={path.startsWith('/places/') ? 'page' : undefined}>꼬똥 플레이스</a>
      </nav>
      <div class="header-actions"><a href="/search/" class="search-link" aria-label="콘텐츠 검색"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" stroke="currentColor" stroke-width="1.7"/><path d="m16 16 5 5" stroke="currentColor" stroke-width="1.7"/></svg></a><a class="instagram desktop-insta" href="https://www.instagram.com/andu.coton/" target="_blank" rel="noopener noreferrer">@andu.coton <span aria-hidden="true">↗</span><span class="sr-only"> (새 창)</span></a></div>
    </div>
    <nav class="mobile-nav" aria-label="모바일 주 메뉴"><a href="/" aria-current={path === '/' ? 'page' : undefined}>홈</a>{Object.entries({stories:'스토리', guides:'가이드', places:'플레이스'}).map(([key,label]) => <a href={`/${key}/`} aria-current={path.startsWith(`/${key}/`) ? 'page' : undefined}>{label}</a>)}</nav>
  </header>
  <main id="main" tabindex="-1"><slot/></main>
  <footer class="site-footer"><div class="wrap footer-top"><div><a href="/" class="footer-brand">COTON PICK<span>꼬똥을 위한 모든 선택</span></a><p>앙두의 작은 일상에서 시작하는<br/>꼬똥과 보호자를 위한 취향 기록.</p></div><div class="footer-links"><a href="/stories/">앙두 스토리</a><a href="/guides/">꼬똥 가이드</a><a href="/places/">꼬똥 플레이스</a><a href="https://www.instagram.com/andu.coton/" target="_blank" rel="noopener noreferrer">Instagram ↗<span class="sr-only"> (새 창)</span></a></div></div><div class="wrap footer-bottom"><span>© {new Date().getFullYear()} COTON PICK</span><span>함께 고르고, 함께 기록해요.</span></div></footer>
</body>
</html>
